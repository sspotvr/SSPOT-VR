  m_TableData:
  - m_Id: 913612800
    m_Localized: 'Mark''s sensors are working again!


      But there are boxes
      all over the room... Shall we teach Mark to go around them?'
    m_Metadata:
      m_Items: []
  - m_Id: 980721664
    m_Localized: 'Put the "If obstacle" block inside a "Repeat" block, 5 times:


      -
      If there is a box ahead: turn right, move forward and turn left.

      - Else:
      move forward.


      Don''t forget the Start and the End!'
    m_Metadata:
      m_Items: []
  - m_Id: 980721665
    m_Localized: 'It worked! Congratulations!


      Now Mark can go around obstacles
      on his own.


      Thank you so much for your help!!'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
