  clipPTBR: {fileID: 8300000, guid: 8855bf7dd9d93344494fbc8214795c18, type: 3}
  subtitlePTBR: "Nesta esta\xE7\xE3o, voc\xEA sempre vai se mover usando as setas
    verdes. Elas mostram para onde voc\xEA pode ir. Continue se movimentando assim
    para me ajudar a aprender como os humanos exploram o espa\xE7o."
