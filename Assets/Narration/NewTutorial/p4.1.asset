  clipPTBR: {fileID: 8300000, guid: 7d3b132cbb9106a429b8d9e4a43ae896, type: 3}
  subtitlePTBR: "Para que eu possa operar o corpo do Mark, preciso que voc\xEA transforme
    suas ideias em instru\xE7\xF5es, ou melhor, em algoritmos, ou programas! J\xE1
    ouviu essas palavras? Algoritmos e Programa?"
  clipENUS: {fileID: 8300000, guid: e54dfd6e483371f49a4a758d77f3ed32, type: 3}
  subtitleENUS: "For me to operate Mark\u2019s body, I need you to transform your
    ideas into instructions, or rather, into algorithms, or programs! Have you heard
    these words before? Algorithms and Program?"
