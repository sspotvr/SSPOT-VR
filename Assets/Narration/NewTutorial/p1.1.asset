  clipPTBR: {fileID: 8300000, guid: 30fa27f0b8965f8428f41565bfef9153, type: 3}
  subtitlePTBR: "Ol\xE1, estudante! Eu sou a Mark 2000, a intelig\xEAncia artificial
    das esta\xE7\xF5es de programa\xE7\xE3o do universo. Esta \xE9 a primeira esta\xE7\xE3o
    da Terra e meu corpo rob\xF3tico ainda n\xE3o sabe se mover aqui."
  clipENUS: {fileID: 8300000, guid: a4b611f702a7e114b9fb47e56949e1af, type: 3}
  subtitleENUS: "Hello, student! I am Mark 2000, the artificial intelligence of the
    programming stations of the universe. This is the first station on Earth and
    my robotic body still doesn\u2019t know how to move here."
